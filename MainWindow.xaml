<Window x:Class="TaskbarBannerApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Taskbar Banner" Width="720" Height="460" WindowStartupLocation="CenterScreen" Background="#101827"><Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="TASKBAR BANNER" Foreground="#60A5FA" FontSize="16" FontWeight="Bold"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="A better way to support the tools you use" Foreground="White" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StatusText" Text="Demo mode — simulated registration" Foreground="#A7B4C8" FontSize="16" Margin="0,18,0,24"/><TextBlock x:Name="RecordText" Text="Active record: 0 seconds" Foreground="#34D399" FontSize="20"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button x:Name="RegisterButton" Content="Register (demo)" Click="Register_Click" Padding="18,10"/><Button Content="Open taskbar settings" Click="Settings_Click" Padding="18,10" Margin="10,0,0,0"/><CheckBox x:Name="BannerToggle" Content="Show banner" IsChecked="True" Click="BannerToggle_Click" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></StackPanel><TextBlock Grid.Row="2" Text="Windows 10 / 11 • Local demo record • Auto-hide must be off" Foreground="#718096"/></Grid></Window>